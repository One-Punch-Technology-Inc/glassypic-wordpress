{
  "name": "glassypic/glassypic",
  "description": "WordPress plugin for GlassyPic — AI image optimization pipeline: upscale (Real-ESRGAN), resize, perceptual compression, and auto-generate SEO alt text. Runs in background via ActionScheduler.",
  "type": "wordpress-plugin",
  "keywords": [
    "wordpress",
    "wordpress-plugin",
    "image-optimization",
    "image-compression",
    "webp",
    "avif",
    "alt-text",
    "seo",
    "real-esrgan",
    "ai",
    "media-library"
  ],
  "homepage": "https://glassypic.com",
  "support": {
    "docs": "https://glassypic.com/docs",
    "issues": "https://github.com/onepunchtechnology/glassypic-wordpress/issues",
    "source": "https://github.com/onepunchtechnology/glassypic-wordpress"
  },
  "authors": [
    {
      "name": "GlassyPic",
      "homepage": "https://glassypic.com",
      "role": "Developer"
    }
  ],
  "license": "GPL-2.0-only",
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.1",
    "woocommerce/action-scheduler": "^3.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "brain/monkey": "^2.6",
    "squizlabs/php_codesniffer": "^3.7",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "autoload": {
    "psr-4": { "GlassyPic\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "GlassyPic\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit --testdox",
    "lint": "phpcs --standard=WordPress src/"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
